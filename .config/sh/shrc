#!/bin/sh

# Common rc for interactive shells (zsh, bash, ksh, ...).

# Switch to zsh if available, unless zsh is already the login shell
# (or we were started from a shell that switched to it).
if [ -z "$ZSH_VERSION" ] && [ "${SHELL##*/}" != zsh ]; then
    case "$-" in *i*)
        if command -v zsh >/dev/null 2>&1; then
            SHELL=$(command -v zsh)
            export SHELL
            echo "Switching to zsh. To make it permanent: chsh -s $SHELL" >&2
            exec "$SHELL" -l
        fi
        ;;
    esac
fi

for profile in ~/.config/sh/shrc.d/*.sh; do
    . "$profile"
done
unset profile
