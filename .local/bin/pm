#!/bin/bash

PM_SLEEP_MODE="${PM_SLEEP_MODE:-sleep}"
PM_POWER_SUPPLY_AC="${PM_POWER_SUPPLY_AC:-/sys/class/power_supply/AC/online}"

service_start() {
    local name="$1"
    shift
    exec -a "${name}" bash "$0" "$@"
}

service_kill() {
    local name="$1"
    shift
    pkill "$@" -f "^${name}" &>/dev/null
}

service_stop() {
    service_kill "$1"
}

service_restart() {
    service_stop "$1" && sleep 0.5
    service_start "$@"
}

is_locked() {
    #pgrep -U "${USER}" -x swaylock &>/dev/null
    pgrep -U "${USER}" -x hyprlock &>/dev/null
}

lock() {
    #is_locked || swaylock -f
    is_locked || hyprlock &
    sleep 1
}

is_monitor_on() {
    if [[ $SWAYSOCK ]]; then
        swaymsg -t get_outputs | jq -e 'any(.[]; .dpms == true)' >/dev/null
    elif [[ $NIRI_SOCKET ]]; then
        :
    elif [[ $HYPRLAND_INSTANCE_SIGNATURE ]]; then
        hyprctl monitors -j | jq -e '[.[].dpmsStatus] | any' >/dev/null
    fi
}

_dim() {
    local brightness="$1"
    shift

    if [[ $# == 0 ]]; then
        return
    fi

    args=()
    for i in "$@"; do
        args+=(--output "$i" --brightness "${brightness}")
    done
    xrandr "${args[@]}"
}

dim() {
    case "$1" in
    on)
        grep "brightness-day=0.5" ~/.config/gammastep/config.ini &>/dev/null && return
        sed -i "/^brightness-/ s/=.*/=0.5/" ~/.config/gammastep/config.ini
        ;;
    off)
        grep "brightness-day=1.0" ~/.config/gammastep/config.ini &>/dev/null && return
        sed -i "/^brightness-/ s/=.*/=1.0/" ~/.config/gammastep/config.ini
        ;;
    reset) ;;

    *)
        return
        ;;
    esac
    systemctl --user restart gammastep
}

is_source_silent() {
    # Sample a quarter second from a monitor source and succeed only if every
    # byte is zero.  A short or failed capture counts as not silent, so a
    # broken probe errs on the side of staying awake.
    timeout 5 parec -d "$1" --raw --format=s16le --channels=2 --rate=48000 \
        --latency-msec=50 2>/dev/null | cmp -s -n 48000 - /dev/zero
}

is_audio_playing() {
    # Only count streams that are actually playing.  A sink stays RUNNING
    # while any client merely holds a (paused or silent) stream on it, so the
    # sink state alone would block sleep forever.  Even an uncorked, unmuted
    # stream may carry nothing but silence (fluidsynth keeps one open for as
    # long as it runs), so sample the monitor of every sink such a stream
    # feeds and look for actual sound.
    local monitor monitors

    monitors="$(
        {
            pactl -f json list sink-inputs
            pactl -f json list sinks
        } 2>/dev/null |
            jq -rs --arg ignore "${PM_AUDIO_IGNORE:-}" '
                .[1] as $sinks
                | .[0][]
                | select(.corked == false and .mute == false)
                | select($ignore == "" or
                         ([.properties["application.name"],
                           .properties["application.process.binary"],
                           .properties["node.name"]]
                          | map(select(. != null))
                          | any(test($ignore))
                          | not))
                | .sink as $index
                | $sinks[]
                | select(.index == $index)
                | .monitor_source
            ' 2>/dev/null | sort -u
    )"

    for monitor in ${monitors}; do
        is_source_silent "${monitor}" || return 0
    done
    return 1
}

is_battery_powered() {
    [[ "$(cat "${PM_POWER_SUPPLY_AC}" 2>/dev/null)" == "0" ]]
}

sleep_loop() {
    local loadavg1

    while true; do
        sleep 30 &
        wait $! || continue

        is_monitor_on && continue

        is_audio_playing && continue

        loadavg1="$(head -c 4 /proc/loadavg)"
        ((${loadavg1%.*} >= 1)) && continue

        if systemctl "${PM_SLEEP_MODE}" --dry-run &>/dev/null; then
            systemctl "${PM_SLEEP_MODE}"
        fi
    done
}

main() {
    local path main_argv0

    path="$(realpath "$0")"
    main_argv0="${path}: main service"

    case "$1" in
    start)
        service_stop "$main_argv0" && sleep 0.5
        service_start "$main_argv0" __start
        ;;
    __start)
        trap "exit" INT TERM
        trap "kill 0" EXIT
        trap " " USR1

        swayidle -w \
            timeout 30 "$0 try-blank" resume "$0 unblank" \
            timeout 300 "$0 battery-dim" resume "$0 undim" \
            timeout 330 "$0 battery-blank" resume "$0 unblank" \
            timeout 600 "$0 dim" resume "$0 undim" \
            timeout 630 "$0 blank" resume "$0 unblank" \
            lock "$0 lock" \
            before-sleep "$0 lock" \
            after-resume "$0 unblank; $0 redshift" &

        dim reset

        if [[ ${PM_ALLOW_SLEEP:-1} -ne 0 ]]; then
            sleep_loop
        fi

        while true; do
            wait && break
        done
        ;;
    stop)
        service_stop "$main_argv0"
        ;;
    lock)
        lock
        ;;
    is-locked)
        is_locked
        ;;
    try-blank)
        is_locked && main blank
        ;;
    battery-blank)
        if is_battery_powered; then
            main blank
        else
            dim off
        fi
        ;;
    blank)
        lock
        if [[ $SWAYSOCK ]]; then
            swaymsg "output * power off"
        elif [[ $NIRI_SOCKET ]]; then
            niri msg action power-off-monitors
        elif [[ $HYPRLAND_INSTANCE_SIGNATURE ]]; then
            hyprctl dispatch dpms off
        fi
        service_kill "$main_argv0" -USR1
        ;;
    unblank)
        is_monitor_on && return
        service_kill "$main_argv0" -USR1
        if [[ $SWAYSOCK ]]; then
            swaymsg "output * power on"
        elif [[ $NIRI_SOCKET ]]; then
            niri msg action power-on-monitors
        elif [[ $HYPRLAND_INSTANCE_SIGNATURE ]]; then
            hyprctl dispatch dpms on
        fi
        ;;
    battery-dim)
        is_battery_powered && main dim
        ;;
    dim)
        dim on
        ;;
    undim)
        dim off
        ;;
    redshift)
        dim reset
        ;;
    esac
}

main "$@"
